# Environment Variables - Hotel Management System
# This is a template. Copy to .env and fill in actual values.
# WARNING: Never commit .env file to GitHub!

# ============================================
# SERVER CONFIGURATION
# ============================================

# Application port
PORT=5000

# Environment (development, production)
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8000

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name
# Get from MongoDB Atlas Dashboard > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hotel-management

# ============================================
# AUTHENTICATION
# ============================================

# JWT Secret key (use a strong, random string)
# Generate: openssl rand -base64 32
# Minimum 32 characters recommended
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars

# JWT expiration time
JWT_EXPIRATION=30d

# ============================================
# LOGGING & MONITORING
# ============================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging (morgan)
REQUEST_LOGGING=true

# ============================================
# DEVELOPMENT ONLY (Not for Production)
# ============================================

# Enable CORS for development
CORS_ORIGIN=*

# Database logging (debug queries)
DATABASE_DEBUG=false
