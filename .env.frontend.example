# =====================================================
# FRONTEND ENVIRONMENT VARIABLES (.env for frontend-react/)
# =====================================================
# This file documents ALL required environment variables
# for the React/Vite frontend
# =====================================================

# =====================================================
# API CONFIGURATION
# =====================================================
# Description: Backend API base URL
# Format: http(s)://host:port
# Required: YES
# Source: Where your Node.js backend is deployed
# For AWS EC2:
#   - http://public-ip:5000 (HTTP)
#   - https://domain.com:5000 (HTTPS with custom domain)
# For local development:
#   - http://localhost:5000
# Note: Used in src/api/index.js
# Usage: import.meta.env.VITE_API_BASE_URL
VITE_API_BASE_URL=http://100.27.229.219:5000

# =====================================================
# DEVELOPMENT ENVIRONMENT
# =====================================================
# Description: Environment name
# Used for: Conditional logic in code
# Example: if (import.meta.env.MODE === 'production')
VITE_APP_ENV=production

# =====================================================
# BUILD CONFIGURATION (VITE)
# =====================================================
# Description: Build output directory
# Default: dist
# Used by: vite.config.js
VITE_BUILD_OUTDIR=dist

# =====================================================
# API DOCUMENTATION
# =====================================================
# ENV VAR USAGE IN CODE:
#
# VITE_API_BASE_URL:
#   Location: src/api/index.js
#   Usage: const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || 'http://localhost:5000'
#   All API calls prepend this URL
#   Example: GET {API_BASE_URL}/api/health
#
# Accessing env vars in React:
#   import.meta.env.VITE_API_BASE_URL
#   import.meta.env.VITE_APP_ENV
#
# NOTE: Vite only exposes vars prefixed with VITE_
#
# =====================================================
# SETUP INSTRUCTIONS
# =====================================================
# 1. Create file: frontend-react/.env.production
# 2. Set VITE_API_BASE_URL to your backend URL
# 3. For AWS EC2:
#    - If using Elastic IP: http://elastic-ip:5000
#    - If using domain: https://api.yourdomain.com
# 4. For local development, use: http://localhost:5000
# 5. Never commit actual secrets to git
# 6. Run: npm run build (creates optimized dist/)
#
# =====================================================
# API ENDPOINTS (called via VITE_API_BASE_URL)
# =====================================================
# All endpoints are relative to VITE_API_BASE_URL
#
# Health Check:
#   GET /api/health
#
# Authentication:
#   POST /api/auth/register - Create new user
#   POST /api/auth/login - Login and get JWT token
#
# Bookings (require JWT token in Authorization header):
#   GET /api/bookings - List user's bookings
#   POST /api/book-room - Create new booking
#   GET /api/bookings/:id - Get specific booking
#   PUT /api/bookings/:id - Update booking
#   DELETE /api/bookings/:id - Delete booking
#
# =====================================================
# VITE BUILD OPTIMIZATION
# =====================================================
# When building for production:
#   cd frontend-react
#   npm run build
#
# This creates:
#   - dist/index.html (main HTML file)
#   - dist/assets/index-[hash].js (React app code)
#   - dist/assets/index-[hash].css (Styling)
#   - dist/assets/*-vendor-[hash].js (React & Router libs)
#
# Total size: ~213 KB (minified and gzipped)
#
# =====================================================
# VERIFICATION CHECKLIST
# =====================================================
# [ ] VITE_API_BASE_URL is set correctly
# [ ] Backend is running and accessible at that URL
# [ ] API health endpoint responds: GET {VITE_API_BASE_URL}/api/health
# [ ] Frontend can make requests (check Network tab in browser)
# [ ] JWT tokens are properly sent in Authorization header
# [ ] .env.production is in .gitignore
# [ ] npm run build completes without errors
# [ ] dist/ folder contains 5+ files
#
# =====================================================
