# =====================================================
# BACKEND ENVIRONMENT VARIABLES (.env for backend/)
# =====================================================
# This file documents ALL required environment variables
# for the Node.js/Express backend
# =====================================================

# =====================================================
# SERVER CONFIGURATION
# =====================================================
# Description: Port where Express server listens
# Default: 5000
# Source: Application setting
PORT=5000

# Description: Node environment (production/development)
# Default: development
# Source: Application setting
NODE_ENV=production

# =====================================================
# DATABASE CONFIGURATION (MONGODB)
# =====================================================
# Description: MongoDB connection URI
# Format: mongodb://username:password@host:port/database
# For MongoDB Atlas:
#   mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# For Local MongoDB:
#   mongodb://localhost:27017/hotel-management
# Required: YES
# Source: MongoDB Atlas Console (https://cloud.mongodb.com/)
#   - Go to Databases -> Connect -> Connection String
#   - Choose "Connect your application"
#   - Copy the connection string
#   - Replace <password> and <database>
MONGODB_URI=mongodb+srv://krishnapotdar619_db_user:PLRCjgTZylOGaP4N@cluster0.k48hsiy.mongodb.net/hotel-management?appName=Cluster0

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Description: Secret key for signing JWT tokens
# Length: 32+ characters (alphanumeric + symbols recommended)
# Required: YES
# SECURITY: This MUST be:
#   - Long and complex
#   - Different for each environment
#   - Never committed to version control
#   - Rotated periodically
# Source: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: 7f9c4e8d2a1b6f5c3e9d7a2b8f1c4e6d9a3b5c7e8f0d2a4b6c8e9f1a3d5c7e9f
JWT_SECRET=your-super-secret-key-32-characters-minimum

# =====================================================
# CORS CONFIGURATION
# =====================================================
# Description: Comma-separated list of allowed origins
# Format: url1,url2,url3
# Required: YES for production
# Source: Your frontend deployment URL(s)
# For AWS S3 hosting:
#   - http://bucket-name.s3-website-region.amazonaws.com
#   - https://bucket-name.s3-website-region.amazonaws.com
# For local development:
#   - http://localhost:3000
#   - http://localhost:3001
# For custom domain:
#   - https://yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://hotel-management-frontend.s3-website-us-east-1.amazonaws.com,https://hotel-management-frontend.s3-website-us-east-1.amazonaws.com

# =====================================================
# LOGGING CONFIGURATION (OPTIONAL)
# =====================================================
# Description: Logging level
# Options: info, warn, error, debug
# Default: info
LOG_LEVEL=info

# Description: Enable request logging
# Options: true/false
# Default: true
REQUEST_LOGGING=true

# =====================================================
# AWS CONFIGURATION (OPTIONAL - for future use)
# =====================================================
# Description: AWS Region where EC2 instance is located
# Source: AWS Console
# Example: us-east-1, us-west-2, eu-west-1
AWS_REGION=us-east-1

# Description: AWS EC2 Instance ID (for monitoring)
# Source: AWS Console -> EC2 -> Instances
# Example: i-1234567890abcdef0
AWS_INSTANCE_ID=i-1234567890abcdef0

# =====================================================
# API DOCUMENTATION
# =====================================================
# ENV VAR USAGE IN CODE:
#
# PORT and NODE_ENV:
#   const PORT = process.env.PORT || 5000;
#   const isDev = process.env.NODE_ENV === 'development';
#
# MONGODB_URI:
#   await mongoose.connect(process.env.MONGODB_URI)
#
# JWT_SECRET:
#   jwt.verify(token, process.env.JWT_SECRET)
#   jwt.sign(data, process.env.JWT_SECRET, { expiresIn: '30d' })
#
# CORS_ORIGIN:
#   const corsOptions = {
#     origin: process.env.CORS_ORIGIN.split(',').map(url => url.trim())
#   }
#
# =====================================================
# SETUP INSTRUCTIONS
# =====================================================
# 1. Copy this file to: backend/.env
# 2. Replace all placeholder values with actual credentials
# 3. For MONGODB_URI:
#    - Go to https://cloud.mongodb.com/
#    - Create a cluster (free tier available)
#    - Get connection string from "Connect" button
#    - Add your username, password, and database name
# 4. For JWT_SECRET:
#    - Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    - Make it 32+ characters
# 5. For CORS_ORIGIN:
#    - List all domains that will call this API
#    - Include both http:// and https:// versions
# 6. Save file (never commit to git)
# 7. Run: npm start
#
# =====================================================
# VERIFICATION CHECKLIST
# =====================================================
# [ ] PORT is accessible (default 5000)
# [ ] NODE_ENV is set to 'production'
# [ ] MONGODB_URI connects successfully (check startup logs)
# [ ] JWT_SECRET is 32+ characters
# [ ] CORS_ORIGIN includes all frontend domains
# [ ] All values are non-empty strings
# [ ] .env file is in .gitignore
# [ ] Running on EC2 with IP: 23.22.102.15
#
# =====================================================
