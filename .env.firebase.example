# =====================================================
# FIREBASE ENVIRONMENT VARIABLES (.env.firebase)
# =====================================================
# This file documents ALL required environment variables
# for Firebase Authentication and Google Cloud integration
# =====================================================

# =====================================================
# FIREBASE PROJECT CONFIGURATION
# =====================================================
# Description: Firebase API Key
# Type: Public API Key (safe to expose in frontend code)
# Required: YES
# Source: Firebase Console (https://console.firebase.google.com/)
# Steps to get:
#   1. Go to Firebase Console
#   2. Select your project
#   3. Click Settings (gear icon) -> Project Settings
#   4. Go to "Your apps" section
#   5. Click on your web app (create one if needed)
#   6. Copy "apiKey" value
# Security: This is a public key for web apps, safe to expose
VITE_FIREBASE_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Description: Firebase Authentication Domain
# Format: project-id.firebaseapp.com
# Required: YES
# Source: Firebase Console -> Project Settings
# Example: hotel-management-12345.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=hotel-management-xxxx.firebaseapp.com

# Description: Google Cloud Project ID
# Format: project-name-12345
# Required: YES
# Source: Firebase Console -> Project Settings
# Example: hotel-management-12345
VITE_FIREBASE_PROJECT_ID=hotel-management-xxxxx

# Description: Firebase Storage Bucket
# Format: project-id.appspot.com
# Required: YES (for file uploads)
# Source: Firebase Console -> Project Settings
# Example: hotel-management-12345.appspot.com
# Used for: Cloud Storage file uploads
VITE_FIREBASE_STORAGE_BUCKET=hotel-management-xxxxx.appspot.com

# Description: Firebase Cloud Messaging Sender ID
# Format: Numeric ID
# Required: YES
# Source: Firebase Console -> Project Settings
# Example: 123456789012
# Used for: Push notifications (optional feature)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Description: Firebase Application ID
# Format: Numeric ID
# Required: YES
# Source: Firebase Console -> Project Settings
# Example: 1:123456789012:web:abcdef1234567890
VITE_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxx

# =====================================================
# GOOGLE OAUTH CONFIGURATION (Optional)
# =====================================================
# Description: Google OAuth Client ID (for "Sign in with Google")
# Type: Public OAuth Client ID
# Required: NO (only if implementing OAuth)
# Source: Google Cloud Console (https://console.cloud.google.com/)
# Steps to get:
#   1. Go to Google Cloud Console
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add authorized JavaScript origins:
#      - http://localhost:3000
#      - http://localhost:3001
#      - https://hotel-management-frontend.s3-website-us-east-1.amazonaws.com
#   4. Add authorized redirect URIs (same as above)
#   5. Copy Client ID
VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# =====================================================
# API DOCUMENTATION
# =====================================================
# ENV VAR USAGE IN CODE:
#
# Firebase Configuration:
#   Location: src/firebase/useFirebaseAuth.js
#   Usage: initializeApp(firebaseConfig)
#   All values from VITE_FIREBASE_* are combined into firebaseConfig
#
# Authentication:
#   createUserWithEmailAndPassword(auth, email, password)
#   signInWithEmailAndPassword(auth, email, password)
#   signOut(auth)
#
# OAuth Sign-in:
#   signInWithPopup(auth, googleProvider)
#
# =====================================================
# SETUP INSTRUCTIONS
# =====================================================
# 1. Create Firebase Project:
#    - Go to https://console.firebase.google.com/
#    - Click "Add project"
#    - Enter project name (e.g., "hotel-management")
#    - Follow wizard to create
#
# 2. Create Web App:
#    - In Firebase Console, click "+ Add app"
#    - Select "Web" (</>)
#    - Enter app name
#    - Copy the config values
#
# 3. Enable Authentication:
#    - Go to "Authentication" in Firebase
#    - Click "Get started"
#    - Enable "Email/Password" provider
#    - Enable "Google" provider (optional)
#
# 4. Create .env.firebase file in frontend-react/:
#    - Copy values from Firebase Console
#    - Save in root of frontend-react/
#
# 5. Update .env.production:
#    - Add all VITE_FIREBASE_* variables
#
# 6. Install Firebase:
#    - npm install firebase
#
# 7. Use authentication hook:
#    - import { useFirebaseAuth } from '@/firebase/useFirebaseAuth'
#    - const { user, loginWithEmail, logout } = useFirebaseAuth()
#
# =====================================================
# VERIFICATION CHECKLIST
# =====================================================
# [ ] All VITE_FIREBASE_* values are from Firebase Console
# [ ] apiKey, authDomain, projectId, appId are non-empty
# [ ] Firebase Authentication is enabled in Firebase Console
# [ ] Email/Password provider is enabled
# [ ] Google provider is enabled (if using OAuth)
# [ ] npm install firebase is completed
# [ ] useFirebaseAuth hook is imported in components
# [ ] onAuthStateChanged updates user state
# [ ] Login/Logout/Register functions work in browser
# [ ] .env.firebase is in .gitignore
# [ ] GitHub has no Firebase secrets committed
#
# =====================================================
# FIREBASE SECURITY RULES
# =====================================================
# After setting up, configure Firestore/Storage rules:
#
# Firestore Rules (Firebase Console -> Firestore -> Rules):
# rules_version = '2';
# service cloud.firestore {
#   match /databases/{database}/documents {
#     match /users/{userId} {
#       allow read, write: if request.auth.uid == userId;
#     }
#     match /bookings/{bookingId} {
#       allow read, write: if request.auth.uid == resource.data.userId;
#     }
#   }
# }
#
# Storage Rules (Firebase Console -> Storage -> Rules):
# rules_version = '2';
# service firebase.storage {
#   match /b/{bucket}/o {
#     match /users/{userId}/{allPaths=**} {
#       allow read, write: if request.auth.uid == userId;
#     }
#   }
# }
#
# =====================================================
